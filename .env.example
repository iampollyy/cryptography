# ==============================================================
#  Environment Variables for NFT Contract Deployment
# ==============================================================
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit .env to git — it contains your private key!
# ==============================================================

# Your wallet private key from MetaMask (without 0x prefix)
# MetaMask → Account → Account Details → Export Private Key
PRIVATE_KEY=your_private_key_here

# Alchemy or Infura RPC URL for Sepolia testnet
# Sign up at https://www.alchemy.com/ (free) and create an app
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here

# (Optional) Student wallet address to mint NFTs to
# If not set, the second Hardhat signer will be used for local testing
STUDENT_ADDRESS=0xYourStudentWalletAddressHere
